{
  "name": "@bharosa/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:create": "node-pg-migrate create --migration-dir migrations",
    "migrate:up": "node-pg-migrate up --migration-dir migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migration-dir migrations --database-url-var DATABASE_URL"
  },
  "dependencies": {
    "@bharosa/shared-contracts": "*",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.0",
    "node-pg-migrate": "^7.7.0",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0"
  }
}
